---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Wordmark from '../components/Wordmark.astro';
import SharedPortrait from '../components/SharedPortrait.astro';
import ScrollCue from '../components/ScrollCue.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import ShowcaseModal from '../components/ShowcaseModal.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';

import { getCollection, render } from 'astro:content';

interface Props {
  initialModalSlug?: string;
  title?: string;
  description?: string;
}

const { initialModalSlug, title, description } = Astro.props;

const showcases = (await getCollection('showcases')).sort((a, b) => a.data.order - b.data.order);
const renderedShowcases = await Promise.all(
  showcases.map(async (showcase) => {
    const { Content } = await render(showcase);
    return { showcase, Content };
  }),
);

// Only what modal.ts actually renders — cards are built server-side.
const showcaseData = showcases.map((showcase) => ({
  slug: showcase.id,
  title: showcase.data.title,
  subtitle: showcase.data.subtitle,
  summary: showcase.data.summary,
  heroImage: showcase.data.heroImage,
  heroAlt: showcase.data.heroAlt,
  heroRatio: showcase.data.heroRatio,
  externalLink: showcase.data.externalLink,
  githubLink: showcase.data.githubLink,
  ctas: showcase.data.ctas,
}));
---

<BaseLayout initialModalSlug={initialModalSlug} title={title} description={description}>
  <Navigation slot="furniture" />
  <Wordmark slot="furniture" />
  <SharedPortrait slot="furniture" />
  <ScrollCue slot="furniture" />

  <div class="scroll-container">
    <div class="horizontal-track">
      <Hero />
      <About />

      <section class="section work" id="work" aria-label="Work">
        <div class="work-inner">
          <h2 class="sr-only">Work</h2>

          <div class="work-row">
            {showcases.map((showcase) => <ShowcaseCard showcase={showcase} />)}
          </div>
        </div>
      </section>

      <Process />
      <Contact />
    </div>
  </div>

  <div class="case-templates" hidden>
    {renderedShowcases.map(({ showcase, Content }) => (
      <template id={`case-template-${showcase.id}`}>
        <div class="case-content">
          <Content />
        </div>
      </template>
    ))}
  </div>

  <script is:inline type="application/json" id="showcase-data" set:html={JSON.stringify(showcaseData)}></script>

  <ShowcaseModal />

  {/* inside the layout, so it renders within <body> rather than after </html> */}
  <script>
    import '../scripts/reveal';
    import '../scripts/scroll';
    import '../scripts/modal';
    import '../scripts/navigation';
  </script>
</BaseLayout>

<style>
  .work {
    background: var(--color-bg);
  }

  .work-inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: safe center;
    justify-content: center;
    /* symmetric, so the row stays optically centred on tall screens */
    padding: var(--nav-clearance) 5.5vw;
  }

  /* four cards whose zones align via subgrid. column-gap only: a row-gap would
     reappear inside every card, between its subgridded tracks. */
  .work-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: clamp(22px, 2.3vw, 50px);
    width: 100%;
    align-items: start;
  }

  @media (max-height: 760px) {
    .work-inner {
      padding: var(--nav-clearance) 5.5vw clamp(24px, 4vh, 48px);
    }
  }

  @media (max-width: 820px), (max-height: 519px), (pointer: coarse) and (max-width: 1024px), (prefers-reduced-motion: reduce) {
    .work-inner {
      position: static;
      display: block;
      padding: 10vh 7vw 10vh;
    }

    .work-row {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    /* wide but stacked (portrait tablet, landscape phone, reduced motion): two
       columns, four from 1100px, so the square art doesn't fill the screen */
    @media (min-width: 600px) {
      .work-row {
        grid-template-columns: 1fr 1fr;
        gap: 44px clamp(24px, 3vw, 44px);
      }
    }

    @media (min-width: 1100px) {
      .work-row {
        grid-template-columns: repeat(4, 1fr);
      }
    }
  }
</style>
