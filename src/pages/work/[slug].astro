---
// Direct modal URLs (/work/fair-monetisation): renders the home page with the
// modal open on load.
import { getCollection } from 'astro:content';
import HomePage from '../index.astro';

export async function getStaticPaths() {
  const showcases = await getCollection('showcases');
  return showcases.map((showcase) => ({
    params: { slug: showcase.id },
    props: { title: `${showcase.data.title} — Valentin Lenzing` },
  }));
}

const { slug } = Astro.params;
const { title } = Astro.props;
---

<HomePage initialModalSlug={slug} title={title} />
