---
const phases = [
  {
    title: 'Discover',
    subtitle: 'research',
    items: [
      'Desk research',
      'Competitive analysis',
      'Stakeholder workshops',
      'User interviews',
      'Heuristic evaluation',
    ],
    tools: ['Notion', 'Dovetail', 'Google Forms'],
  },
  {
    title: 'Define',
    subtitle: 'synthesis',
    items: [
      'Problem framing',
      'Personas',
      'User journeys & flows',
      'Information architecture',
      'Feature prioritisation',
    ],
    tools: ['FigJam', 'Miro', 'Jira', 'Confluence'],
  },
  {
    title: 'Develop',
    subtitle: 'design',
    items: [
      'Wireframes',
      'Visual design',
      'Interactive prototyping',
      'Usability testing',
      'Component & token systems',
    ],
    tools: ['Figma', 'Affinity', 'Adobe CC', 'Maze'],
  },
  {
    title: 'Deliver',
    subtitle: 'code',
    items: [
      'Frontend development',
      'Accessibility implementation',
      'Performance optimisation',
      'Design-to-code handoff',
      'Documentation',
    ],
    tools: ['HTML/CSS', 'TypeScript', 'React', 'Astro', 'Git'],
  },
];
---

<section class="section process" id="process" aria-label="Process">
  <div class="process-inner">
    <h2 class="sr-only">Process</h2>

    {/* the double diamond shares the columns' box: tips on the column
        boundaries, waist on their vertical centre */}
    <div class="pr-grid">
      {/* one continuous stroke ("Haus vom Nikolaus"): over the first peak, down
          through the centre into the far valley, up the right tip, back over
          the second peak to the centre, and down to close */}
      <svg class="pr-dia" viewBox="0 0 1600 760" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0,380 L400,80 L800,380 L1200,680 L1600,380 L1200,80 L800,380 L400,680 Z"
          pathLength="1"></path>
      </svg>

      <div class="pr-cols">
        {
          phases.map((phase, i) => (
            <div class="pr-col reveal reveal-x" style={`--i:${i}`}>
              <span class="pr-mark" aria-hidden="true" />
              <span class="pr-tag">{phase.subtitle}</span>
              <h3 class="pr-name">{phase.title}</h3>
              <ul class="pr-acts">
                {phase.items.map((item) => (
                  <li class="pr-act">{item}</li>
                ))}
              </ul>
              {/* NBSP before "·" so a wrapping list breaks after a separator, not before one */}
              <p class="pr-tools">{phase.tools.join(' · ')}</p>
            </div>
          ))
        }
      </div>
    </div>

    <p class="pr-statement reveal reveal-rise" style="--i:4">
      The framework above is the foundation; the reality is iterative.<br />
      I use these phases to turn user insights into clean, buildable interfaces.<br />
      AI tooling accelerates the routine work; the decisions stay mine.
    </p>
  </div>
</section>

<style>
  .process {
    background: var(--color-bg);
  }

  .process-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    padding: var(--nav-clearance) 5.5vw;
    overflow: hidden;
  }

  .pr-grid {
    position: relative;
  }

  /* explicit width: an absolutely positioned SVG may size itself from its
     viewBox ratio instead of stretching across the columns */
  .pr-dia {
    position: absolute;
    left: 0;
    top: 50%;
    display: block;
    width: 100%;
    height: 132%;
    transform: translateY(-50%);
    z-index: 0;
    pointer-events: none;
  }

  /* The line draws once the visitor has arrived (.is-centred, not .is-in);
     pathLength="1" lets one dash offset trace the whole outline.
     The stroke scales with the box on purpose. With non-scaling-stroke, Chrome
     converts the dash using one averaged scale factor, and on this non-uniformly
     stretched SVG the draw-in stopped before closing. */
  .pr-dia path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.7;
    opacity: 0.24;
  }

  :global(html.js) .pr-dia path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 4.2s cubic-bezier(0.4, 0, 0.18, 1),
      opacity 0.9s ease;
  }

  :global(html.js) .process.is-centred .pr-dia path {
    stroke-dashoffset: 0;
    opacity: 0.17;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .pr-dia path {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      opacity: 0.17;
      transition: none;
    }
  }

  .pr-cols {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .pr-col {
    padding: 0 clamp(22px, 2.2vw, 44px);
  }

  .pr-col:first-child {
    padding-left: 0;
  }

  .pr-col:last-child {
    padding-right: 0;
  }

  .pr-mark {
    display: block;
    width: 11px;
    height: 11px;
    margin: 0 0 22px;
    background: var(--color-accent);
    transform: rotate(45deg);
    box-shadow: 0 0 0 5px rgb(217 179 108 / 0.1);
  }

  .pr-tag {
    display: block;
    margin: 0 0 16px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: max(13.5px, calc(13.5 / 17 * var(--up)));
    letter-spacing: 0.18em;
    color: var(--color-accent);
    transition: color 0.3s ease;
  }

  .pr-name {
    margin: 0 0 26px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: max(clamp(30px, 3.1vw, 48px), calc(48 / 17 * var(--up)));
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--color-text);
    transition: color 0.3s ease;
  }

  .pr-acts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pr-act {
    padding: 7px 0;
    font-family: var(--font-body);
    font-size: max(14.5px, calc(14.5 / 17 * var(--up)));
    line-height: 1.45;
    color: var(--color-text-soft);
    /* even lines when a label wraps on a narrow desktop */
    text-wrap: balance;
    transition: color 0.3s ease;
  }

  .pr-act:first-child {
    padding-top: 0;
  }

  /* gold toolkit line. No hover states: the columns are a reference, not a control. */
  .pr-tools {
    margin: 32px 0 0;
    font-family: var(--font-body);
    font-size: max(12.5px, calc(12.5 / 17 * var(--up)));
    letter-spacing: 0.02em;
    line-height: 1.6;
    color: var(--color-accent);
    /* no lone orphaned tool when it wraps */
    text-wrap: balance;
  }

  .pr-statement {
    position: relative;
    z-index: 1;
    max-width: 64ch;
    margin: 10.5vh auto 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: max(clamp(16px, 1.5vw, 19px), calc(19 / 17 * var(--up)));
    line-height: 1.6;
    color: var(--color-text-dim);
    text-align: center;
  }

  /* short desktop windows: keep the statement inside the 100vh frame */
  @media (max-height: 760px) {
    .process-inner {
      padding: var(--nav-clearance) 5.5vw clamp(24px, 4vh, 48px);
    }

    .pr-name {
      margin-bottom: 16px;
    }

    .pr-act {
      padding-block: 4px;
    }

    .pr-tools {
      margin-top: 20px;
    }

    .pr-statement {
      margin-top: 5.5vh;
    }
  }

  @media (max-height: 680px) {
    .pr-mark {
      margin-bottom: 14px;
    }

    .pr-tag {
      margin-bottom: 8px;
    }

    .pr-name {
      margin-bottom: 10px;
    }

    .pr-act {
      padding-block: 2px;
    }

    .pr-tools {
      margin-top: 12px;
    }

    .pr-statement {
      margin-top: 3.5vh;
    }
  }

  @media (max-width: 820px), (max-height: 519px), (pointer: coarse) and (max-width: 1024px), (prefers-reduced-motion: reduce) {
    .process-inner {
      position: static;
      display: block;
      padding: 10vh 7vw 10vh;
    }

    .pr-dia {
      display: none;
    }

    .pr-cols {
      grid-template-columns: 1fr 1fr;
      gap: 38px 26px;
    }

    .pr-col {
      padding: 0;
    }

    /* stacked: undo the short-laptop compaction above */
    .pr-mark {
      margin-bottom: 22px;
    }

    .pr-tag {
      margin-bottom: 16px;
    }

    .pr-name {
      margin-bottom: 26px;
      font-size: clamp(28px, 7vw, 40px);
    }

    .pr-act {
      padding-block: 7px;
    }

    .pr-tools {
      margin-top: 32px;
    }

    .pr-statement {
      margin-top: 7vh;
      text-wrap: pretty;
    }

    /* the authored breaks are for the desktop panel */
    .pr-statement br {
      display: none;
    }
  }
</style>
