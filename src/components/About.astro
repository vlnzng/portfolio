---
// The left half of this panel stays empty: the shared portrait
// (SharedPortrait.astro) rests there after gliding in from the hero.
---

<section class="section about" id="about" aria-label="About">
  <h2 class="sr-only">About</h2>
  <div class="about-content">
    <div class="ab-body">
      <p class="ab-hook reveal reveal-x" style="--i:0">Shaped by business, technology and media.</p>
      <p class="reveal reveal-x" style="--i:1">
        I am interested in how digital products are structured, how they guide people and how they
        create trust. For me, design is not only about the surface, but about clarity, usability and
        the decisions that make an experience feel effortless.
      </p>
      <p class="reveal reveal-x" style="--i:2">
        What fascinates me about UX is that good design often goes unnoticed. When it works, people
        simply understand where they are, what they can do and what happens next. That is the kind of
        design I want to create: useful, trustworthy and calm, but with enough character to feel distinct.
      </p>
      <p class="reveal reveal-x" style="--i:3">
        Outside of design, I am drawn to experiences that combine structure, atmosphere and detail,
        whether in games, movies or cooking. I like it when many small choices come together to create
        something people remember.
      </p>
    </div>

    <div class="about-foot">
      <div class="ab-foot-col reveal" style="--i:3">
        <p class="ab-foot-label">Education</p>
        <p class="ab-foot-line">M.Sc. Digital Media &mdash; <span class="ab-school">TH&nbsp;Brandenburg</span></p>
        <p class="ab-foot-line">B.Sc. Social Media Systems &mdash; <span class="ab-school">TH&nbsp;Mittelhessen</span></p>
      </div>
      <div class="ab-foot-col reveal" style="--i:4">
        <p class="ab-foot-label">Languages</p>
        <p class="ab-foot-line">German &mdash; native</p>
        <p class="ab-foot-line">English &mdash; C1</p>
      </div>
      <div class="ab-foot-col reveal" style="--i:5">
        <p class="ab-foot-label">Location</p>
        <p class="ab-foot-line">Berlin Metropolitan Area</p>
        <p class="ab-foot-line"><span class="soft">(open to relocate)</span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-bg);
  }

  /* the whole right column (intro + footer) is one vertically-centred flex
     stack, so the footer always sits below the body with a real gap — it can
     never overlap the paragraphs on short or narrow desktop viewports */
  .about-content {
    position: absolute;
    left: 50vw;
    right: 6vw;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    /* `safe`: a column taller than the frame spills down, never up under the nav */
    justify-content: safe center;
    gap: clamp(26px, 4vh, 56px);
    /* headroom so the vertically-centred column never rises under the fixed
       navbar (top-right) on short viewports, plus matching bottom breathing room */
    padding: clamp(92px, 13vh, 150px) 0 clamp(56px, 8vh, 104px);
    z-index: 20;
  }

  .ab-body {
    /* `ch` resolves against THIS element's font-size, and it has none of its
       own — so the measure stayed pinned to the 16px page default while the
       paragraphs inside grew with --up. At 2560 that squeezed the copy to ~55
       characters and left 521px of the column empty, which is what made the
       panel look unbalanced on a large screen. The --up arm keeps the measure
       at the ~73 characters it was tuned for; 60ch still governs below 1920. */
    max-width: max(60ch, calc(606 / 17 * var(--up)));
  }

  /* scoped under .ab-body so it beats the `.ab-body p` body style */
  .ab-body .ab-hook {
    margin: 0 0 24px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: max(clamp(21px, 1.9vw, 27px), calc(27 / 17 * var(--up)));
    line-height: 1.36;
    letter-spacing: -0.01em;
    color: var(--color-accent);
  }

  .ab-body p {
    margin: 0 0 20px;
    max-width: none;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: max(16.5px, calc(16.5 / 17 * var(--up)));
    line-height: 1.78;
    color: var(--color-text-soft);
  }

  .ab-body p:last-child {
    margin-bottom: 0;
  }

  /* footer strip, divided by thin rules — sits in the flow below the intro */
  .about-foot {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1.05fr;
    align-items: start;
    padding-top: 26px;
    border-top: 1px solid var(--color-border);
  }

  .ab-school {
    white-space: nowrap;
  }

  .ab-foot-col {
    padding-right: 22px;
  }

  .ab-foot-col + .ab-foot-col {
    padding-left: 22px;
    border-left: 1px solid var(--color-border);
  }

  .ab-foot-label {
    margin: 0 0 13px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: max(11px, calc(11 / 17 * var(--up)));
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .ab-foot-line {
    margin: 0 0 5px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: max(13px, calc(13 / 17 * var(--up)));
    line-height: 1.5;
    color: var(--color-muted);
  }

  .ab-foot-line:last-child {
    margin-bottom: 0;
  }

  .ab-foot-line .soft {
    color: var(--color-faint);
  }

  /* Short or narrow desktop windows (a 720p laptop leaves ~590px, still engine
     range): the panel is a fixed 100vh overflow:hidden box, and the tall
     layout's spacing needs ~700px at full column width — tighten to fit. */
  @media (max-height: 760px), (max-width: 1150px) {
    .about-content {
      gap: clamp(14px, 2.2vh, 26px);
      padding: var(--nav-clearance) 0 clamp(24px, 3.5vh, 56px);
    }

    .ab-body .ab-hook {
      margin-bottom: 16px;
      font-size: max(clamp(19px, 1.7vw, 23px), calc(23 / 17 * var(--up)));
      line-height: 1.3;
    }

    .ab-body p {
      margin-bottom: 14px;
      font-size: max(15.5px, calc(15.5 / 17 * var(--up)));
      line-height: 1.66;
    }

    .about-foot {
      padding-top: 18px;
    }

    .ab-foot-label {
      margin-bottom: 9px;
    }
  }

  @media (max-height: 660px) {
    .ab-body .ab-hook {
      margin-bottom: 10px;
    }

    .ab-body p {
      margin-bottom: 10px;
      line-height: 1.55;
    }

    .about-foot {
      padding-top: 14px;
    }
  }

  /* the shortest windows the engine still runs on */
  @media (max-height: 560px) {
    .ab-body .ab-hook {
      margin-bottom: 8px;
    }

    .ab-body p {
      margin-bottom: 8px;
      font-size: max(14.5px, calc(14.5 / 17 * var(--up)));
      line-height: 1.5;
    }
  }

  /* half-screen desktop: the column reclaims the slack beside the portrait and
     the three-column footer gives up some padding */
  @media (max-width: 1150px) {
    .about-content {
      left: 46vw;
      right: 3.5vw;
    }

    .ab-foot-col {
      padding-right: 14px;
    }

    .ab-foot-col + .ab-foot-col {
      padding-left: 14px;
    }
  }

  @media (max-width: 820px), (max-height: 519px), (pointer: coarse) and (max-width: 1024px), (prefers-reduced-motion: reduce) {
    .about-content {
      position: static;
      left: auto;
      right: auto;
      display: block;
      gap: 0;
      padding: 12vh 7vw 10vh;
    }

    .ab-body {
      max-width: none;
    }

    /* the stacked page scrolls freely, so it keeps the full reading type
       instead of the fixed-frame compaction above */
    .ab-body .ab-hook {
      margin-bottom: 24px;
      font-size: max(clamp(21px, 1.9vw, 27px), calc(27 / 17 * var(--up)));
      line-height: 1.36;
    }

    .ab-body p {
      margin-bottom: 20px;
      font-size: max(16.5px, calc(16.5 / 17 * var(--up)));
      line-height: 1.78;
    }

    .ab-foot-label {
      margin-bottom: 13px;
    }

    .about-foot {
      margin-top: 40px;
      padding-top: 26px;
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .ab-foot-col {
      padding-right: 0;
    }

    .ab-foot-col + .ab-foot-col {
      padding-top: 22px;
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
  }
</style>
