---
// Full-screen case-study modal (handoff cs-* design). The shell is static;
// the hero band, head (number/title/subtitle/meta) and CTAs are built by
// modal.ts from the showcase data, and the body is the MDX-rendered case.
---

<div
  class="cs-modal"
  id="showcase-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-hidden="true"
  aria-label="Case study"
  data-lenis-prevent
>
  {/* geometric cross, not a "×" glyph — the glyph sits off-centre in its own
      line box, which read as a wobble on hover */}
  <button class="cs-close" id="modal-close" aria-label="Close case study" type="button">
    <svg class="cs-close-x" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6 6 18 18M18 6 6 18" />
    </svg>
  </button>

  <div class="cs-scroll" id="modal-scroll">
    <div class="cs-hero" id="modal-hero" aria-hidden="true"></div>
    <div class="cs-head" id="modal-meta"></div>
    <div class="cs-body">
      <div id="modal-body" tabindex="-1"></div>
      <div class="cs-cta" id="modal-footer"></div>
    </div>
  </div>
</div>

<style>
  .cs-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: var(--color-bg);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0s linear 0.4s;
  }

  .cs-modal[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s ease;
  }

  .cs-scroll {
    position: absolute;
    inset: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--color-accent) transparent;
  }

  .cs-scroll::-webkit-scrollbar {
    width: 12px;
  }

  .cs-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .cs-scroll::-webkit-scrollbar-thumb {
    background: var(--color-accent);
    border: 3px solid var(--color-bg);
    border-radius: 999px;
  }

  .cs-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--color-accent-bright);
  }

  /* ---- open choreography: the hero image settles, then the head and the
     body rise in, the close button turning in last. Keyframes (not
     transitions) so the stagger re-plays on every open, even though the
     content is injected fresh. Closing fades the modal as one piece. ---- */
  @media (prefers-reduced-motion: no-preference) {
    .cs-modal[aria-hidden='false'] .cs-hero {
      animation: cs-hero-in 0.9s var(--ease-glide) backwards;
    }

    .cs-modal[aria-hidden='false'] .cs-head {
      animation: cs-rise-in 0.7s var(--ease-glide) 0.18s backwards;
    }

    .cs-modal[aria-hidden='false'] .cs-body {
      animation: cs-rise-in 0.8s var(--ease-glide) 0.3s backwards;
    }

    .cs-modal[aria-hidden='false'] .cs-close {
      animation: cs-close-in 0.5s var(--ease-glide) 0.4s backwards;
    }
  }

  @keyframes cs-hero-in {
    from {
      opacity: 0;
      transform: scale(1.045);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes cs-rise-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes cs-close-in {
    from {
      opacity: 0;
      transform: scale(0.7);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  /* same read as the CTAs below: gold-outlined at rest, filled gold on hover.
     The colour change carries the whole state — no rotation. */
  .cs-close {
    position: fixed;
    top: calc(26px + env(safe-area-inset-top, 0px));
    right: calc(30px + env(safe-area-inset-right, 0px));
    z-index: calc(var(--z-modal) + 10);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    border: 1px solid rgb(217 179 108 / 0.45);
    color: var(--color-text);
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition:
      background 0.22s ease,
      color 0.22s ease,
      border-color 0.22s ease;
  }

  .cs-close-x {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .cs-close:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  /* keyboard focus reads as a ring, not the loud gold fill — so opening the
     modal by keyboard (which moves focus here) doesn't leave it stuck gold */
  .cs-close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* hero band */
  .cs-hero {
    position: relative;
    width: 100%;
    /* full-bleed banner. modal.ts sets --cs-hero-ar per case from the image's
       own ratio so it fills the width edge-to-edge with no crop; the fallback
       is the band's native 2400/620, which case 1's diagram is drawn at and
       which the placeholder stripe uses. Capped so a ~2:1 hero can't swallow
       the viewport before any copy — when the cap bites, `contain` leaves
       narrow --color-bg bars rather than cropping into the artwork. */
    aspect-ratio: var(--cs-hero-ar, 2400 / 620);
    max-height: 68vh;
    overflow: hidden;
    background: var(--color-bg);
  }

  .cs-hero :global(.cs-hero-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cs-hero::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 18%;
    background: linear-gradient(0deg, var(--color-bg), transparent);
  }

  /* injected placeholder stripe + caption */
  .cs-hero :global(.wstripe) {
    position: absolute;
    inset: 0;
    background-image: var(--stripe-surface);
  }

  .cs-hero :global(.wcard-cap) {
    position: absolute;
    left: 6vw;
    bottom: 24px;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  /* head + body share one centred column so the intro and the sections line
     up (the full-bleed hero already gives the wide-to-narrow step) — overlaps
     up into the hero */
  .cs-head {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: -40px auto 0;
    padding: 0 clamp(20px, 5vw, 40px);
  }

  .cs-head :global(.cs-title) {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--color-text);
  }

  .cs-head :global(.cs-sub) {
    max-width: 52ch;
    margin: 20px 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(17px, 1.7vw, 22px);
    line-height: 1.5;
    text-wrap: pretty;
    hyphens: auto;
    color: var(--color-text-dim);
  }

  /* at-a-glance — full-width gold divider on the wrapper, gold eyebrow, then
     one or more lead paragraphs */
  .cs-head :global(.cs-glance) {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid rgb(217 179 108 / 0.35);
  }

  .cs-head :global(.cs-glance-label) {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .cs-head :global(.cs-glance-p) {
    margin: 0 0 16px;
    font-family: var(--font-body);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.7;
    text-wrap: pretty;
    hyphens: auto;
    color: var(--color-text-soft);
  }

  .cs-head :global(.cs-glance-p:last-child) {
    margin-bottom: 0;
  }

  /* body — MDX-rendered case, styled as gold-headed sections */
  .cs-body {
    max-width: 820px;
    margin: 0 auto;
    padding: 8vh clamp(20px, 5vw, 40px) 13vh;
  }

  .cs-body :global(.case-content h2) {
    margin: 7.5vh 0 18px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .cs-body :global(.case-content > :first-child) {
    margin-top: 0;
  }

  .cs-body :global(.case-content h3) {
    margin: 4vh 0 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(20px, 1.6vw, 26px);
    color: var(--color-text);
  }

  .cs-body :global(.case-content p) {
    margin: 0 0 18px;
    max-width: none;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(17px, 1.45vw, 19px);
    line-height: 1.72;
    text-wrap: pretty;
    hyphens: auto;
    color: var(--color-text-soft);
  }

  .cs-body :global(.case-content a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cs-body :global(.case-content ul) {
    margin: 0 0 18px;
    padding-left: 1.2em;
    color: var(--color-text-soft);
  }

  .cs-body :global(.case-content li) {
    margin: 0 0 8px;
    line-height: 1.6;
  }

  .cs-body :global(.case-content strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  /* in-body figures break out wider than the reading column for legibility
     (centred on the viewport via the 50% + translateX trick). The shot_*
     screenshots bake in the rounded "product window" + shadow; diagrams are
     flat, site-native data viz. Captions sit centred beneath. */
  .cs-body :global(.case-figure) {
    width: min(1080px, 92vw);
    margin-top: 5vh;
    margin-bottom: 5vh;
    margin-left: 50%;
    transform: translateX(-50%);
  }

  .cs-body :global(.case-figure img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* deliberate figure placeholder — same diagonal-stripe surface as the card and
     hero slots, holding the layout until the real asset lands */
  .cs-body :global(.case-ph) {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: var(--color-surface);
    background-image: var(--stripe-surface);
  }

  .cs-body :global(.case-ph-cap) {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  /* guided-question / archetype callouts (case 1 & 3) — a gold-ruled block so
     the bold label + line read as a distinct example, not body copy. Selector
     carries .case-content to outrank the generic `.case-content p` rule. */
  .cs-body :global(.case-content p.case-q) {
    margin: 0 0 14px;
    padding: 15px 20px;
    border-left: 2px solid rgb(217 179 108 / 0.45);
    background: rgb(237 230 217 / 0.02);
    font-size: clamp(15px, 1.35vw, 17px);
    line-height: 1.6;
    color: var(--color-text-soft);
  }

  .cs-body :global(.case-content p.case-q strong) {
    color: var(--color-text);
  }

  .cs-body :global(.case-figure figcaption) {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--color-muted);
    text-align: center;
  }

  /* pull quote — gold rule + display serif, keeps the single site accent */
  .cs-body :global(.case-quote) {
    margin: 4.5vh 0;
    padding: 6px 0 6px 26px;
    border-left: 2px solid var(--color-accent);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(19px, 1.8vw, 25px);
    line-height: 1.5;
    color: var(--color-text);
  }

  /* CTAs */
  .cs-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 9vh 0 0;
    padding: 38px 0 0;
    border-top: 1px solid var(--color-border);
  }

  .cs-cta:empty {
    display: none;
  }

  /* One button style for every case: gold-outlined at rest, filled gold on
     hover. No primary/secondary split — each case has one thing to open, so
     ranking them against each other would be noise. */
  .cs-cta :global(.cs-btn) {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 999px;
    background: none;
    color: var(--color-text);
    border: 1px solid rgb(217 179 108 / 0.45);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13.5px;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.22s ease, border-color 0.22s ease, color 0.22s ease;
  }

  .cs-cta :global(.cs-btn:hover) {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }

  /* the arrow is the gold note while the button is empty, then joins the
     filled state — same beat as the contact links */
  .cs-cta :global(.cs-btn-arrow) {
    color: var(--color-accent);
    font-size: 14px;
    transition: color 0.22s ease, transform 0.25s var(--ease-out);
  }

  .cs-cta :global(.cs-btn:hover .cs-btn-arrow) {
    color: inherit;
    transform: translate(3px, -3px);
  }

  @media (max-width: 820px) {
    /* bigger, solid, gold-ringed close so it's unmistakable and easy to tap
       on top of any hero image */
    .cs-close {
      top: calc(12px + env(safe-area-inset-top, 0px));
      right: calc(12px + env(safe-area-inset-right, 0px));
      width: 48px;
      height: 48px;
      background: var(--color-bg);
      border-color: var(--color-accent);
      color: var(--color-accent);
      touch-action: manipulation;
    }

    .cs-close-x {
      width: 19px;
      height: 19px;
    }

    .cs-hero {
      /* let the per-case ratio set the height here too — a fixed height
         letterboxed every hero on phones. The floor keeps the band reading as
         a banner for the widest artwork (case 1's 3.87:1 diagram). */
      min-height: 160px;
      max-height: 42vh;
    }

    .cs-head {
      margin-top: -32px;
    }

    .cs-body {
      padding: 6vh 22px 11vh;
    }

    /* on mobile the modal is already near full-width — drop the viewport
       break-out (the 50% margin + translate overflowed the right edge and
       dragged the text columns with it). Figures just fill the column. */
    .cs-body :global(.case-figure) {
      width: 100%;
      margin-left: 0;
      transform: none;
    }
  }
</style>
