---
// Fixed, morphing wordmark — the real Figma lockup, inlined from
// src/assets/brand/wordmark.svg: a V/L monogram with "alentin"/"enzing" tails in a
// calligraphic italic. The tails carry data-wm-tail so the morph can fade them,
// leaving the V (.mark-v, gold) + L — exactly the collapsed monogram (same paths as
// logo.svg / the favicon). scroll.ts drives the fly-to-navbar.
import wordmark from '../assets/brand/wordmark.svg?raw';
---

<a
  class="wordmark"
  href="/#hero"
  aria-label="Valentin Lenzing — home"
  data-wordmark
  data-section-link="hero"
>
  <Fragment set:html={wordmark} />
</a>

<style>
  .wordmark {
    /* --wm-h (the rendered height of the lockup) is a token: the mobile hero
       stack in global.css positions the text block off it */
    position: fixed;
    left: 0;
    top: 0;
    z-index: 65;
    /* resting position ≈ hero left, vertically present (also the
       reduced-motion fallback); the engine takes over from here */
    transform: translate(5.5vw, 20vh);
    transform-origin: left top;
    display: block;
    width: max-content;
    color: var(--color-text);
    text-decoration: none;
    user-select: none;
    will-change: transform;
  }

  .wordmark :global(svg) {
    display: block;
    height: var(--wm-h);
    width: auto;
    overflow: visible; /* let the V's breath/hover glow spill past the box */
  }

  /* the V carries the accent; the L + tails stay cream (currentColor = text) */
  .wordmark :global(.mark-v) {
    color: var(--color-accent);
  }

  /* the tails fade + retract during the morph — scroll.ts sets opacity/transform
     per frame; fill-box + left origin makes its % translate / scale behave */
  .wordmark :global([data-wm-tail]) {
    transform-box: fill-box;
    transform-origin: left center;
    will-change: opacity, transform;
  }

  /* once collapsed into the corner it behaves like a button */
  .wordmark.is-collapsed {
    cursor: pointer;
  }

  /* ---- load-in: the V/L monogram is there from the first frame (it fades up
     with the block); only "alentin" then "enzing" are written in — each clipped
     open left → right on a slight slant that follows the italic (a pen angle) ---- */
  :global(html.js) .wordmark {
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  :global(html.js body.is-loaded) .wordmark {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* each word starts hidden behind a slanted reveal edge parked at its left */
    :global(html.js) .wordmark :global([data-wm-tail]) {
      clip-path: polygon(-50% -50%, -12% -50%, -26% 150%, -50% 150%) fill-box;
    }

    /* both words are written in one continuous, flowing sweep on identical timing,
       so "alentin" and "enzing" glide out together and finish at the same moment */
    :global(html.js body.is-loaded) .wordmark :global([data-wm-tail]) {
      animation: wm-write 2.4s cubic-bezier(0.4, 0.05, 0.35, 1) 0.5s both;
    }

    /* the gold V breathes very gently once the name has settled (hero only) */
    :global(html.js body.is-loaded) .wordmark:not(.is-collapsed) :global(.mark-v) {
      animation: wm-breath 5s ease-in-out 3.3s infinite;
    }
  }

  /* the slanted reveal edge sweeps across, top leading bottom (the italic angle) */
  @keyframes wm-write {
    from {
      clip-path: polygon(-50% -50%, -12% -50%, -26% 150%, -50% 150%) fill-box;
    }
    to {
      clip-path: polygon(-50% -50%, 140% -50%, 126% 150%, -50% 150%) fill-box;
    }
  }

  @keyframes wm-breath {
    0%,
    100% {
      filter: drop-shadow(0 0 0 rgb(217 179 108 / 0));
    }

    50% {
      filter: drop-shadow(0 0 12px rgb(217 179 108 / 0.3));
    }
  }

  /* ---- hover: lift + V glow + a single warm sheen across the letters ----
     works on the hero lockup AND the collapsed home mark */
  .wordmark:hover {
    scale: 1.014;
  }

  .wordmark:hover :global(.mark-v) {
    animation: none;
    filter: drop-shadow(0 0 22px rgb(217 179 108 / 0.52));
  }

  .wordmark::after {
    content: '';
    position: absolute;
    inset: -8% -5%;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 44%,
      color-mix(in srgb, var(--color-accent-bright) 40%, transparent) 50%,
      transparent 56%
    );
    mix-blend-mode: screen;
    opacity: 0;
    transform: translateX(-55%);
  }

  .wordmark:hover::after {
    animation: wm-sheen 0.85s ease-out forwards;
  }

  @keyframes wm-sheen {
    0% {
      opacity: 0;
      transform: translateX(-55%);
    }

    25% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(55%);
    }
  }

  @media (max-width: 820px), (max-height: 519px), (prefers-reduced-motion: reduce) {
    .wordmark {
      /* mobile: a static lockup at the top that scrolls away with the page.
         Top and size both come from the hero stack in global.css. */
      position: absolute;
      left: 7vw;
      top: var(--hero-wm-top);
      transform: none !important;
    }

    .wordmark :global([data-wm-tail]) {
      opacity: 1 !important;
      transform: none !important;
    }

    /* A phone in landscape has ~400px of height, so a width-driven lockup
       (26vw of 852px = the 9.5rem cap) ate the whole hero and collided with
       the role line. Size it off the height there instead. */
    @media (max-height: 519px) {
      .wordmark {
        top: 5svh;
        --wm-h: clamp(2.5rem, 15svh, 4.5rem);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .wordmark {
      opacity: 1;
      transition: none;
    }

    .wordmark :global([data-wm-tail]) {
      clip-path: none !important;
      animation: none !important;
    }

    .wordmark :global(.mark-v) {
      animation: none !important;
      filter: none !important;
    }

    .wordmark::after {
      display: none;
    }

    .wordmark:hover {
      scale: none;
    }
  }
</style>
