---
// The fixed, morphing wordmark (src/assets/brand/wordmark.svg, inlined). The
// morph fades the data-wm-tail groups ("alentin", "enzing"), leaving the V/L
// monogram, the same paths as logo.svg. desktop-engine.ts drives it.
import wordmark from '../assets/brand/wordmark.svg?raw';
---

<a
  class="wordmark"
  href="/#hero"
  aria-label="Valentin Lenzing — home"
  data-wordmark
  data-section-link="hero"
>
  <Fragment set:html={wordmark} />
</a>

<style>
  .wordmark {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 65;
    /* hero rest position; the engine takes over from here */
    transform: translate(5.5vw, 20vh);
    transform-origin: left top;
    display: block;
    width: max-content;
    color: var(--color-text);
    text-decoration: none;
    user-select: none;
    will-change: transform;
  }

  .wordmark :global(svg) {
    display: block;
    height: var(--wm-h);
    width: auto;
    overflow: visible; /* let the V's breath/hover glow spill past the box */
  }

  /* the V carries the accent; the L + tails stay cream (currentColor = text) */
  .wordmark :global(.mark-v) {
    color: var(--color-accent);
  }

  /* the tails fade + retract during the morph — desktop-engine.ts sets opacity/transform
     per frame; fill-box + left origin makes its % translate / scale behave */
  .wordmark :global([data-wm-tail]) {
    transform-box: fill-box;
    transform-origin: left center;
    will-change: opacity, transform;
  }

  /* once collapsed into the corner it behaves like a button */
  .wordmark.is-collapsed {
    cursor: pointer;
  }

  /* ---- load-in: the V/L fades up with the block; only the tails are written
     in, clipped open on a slant that follows the italic ---- */
  :global(html.js) .wordmark {
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  :global(html.js body.is-loaded) .wordmark {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* each word starts hidden behind a slanted reveal edge parked at its left */
    :global(html.js) .wordmark :global([data-wm-tail]) {
      clip-path: polygon(-50% -50%, -12% -50%, -26% 150%, -50% 150%) fill-box;
    }

    /* both words write in together, on identical timing */
    :global(html.js body.is-loaded) .wordmark :global([data-wm-tail]) {
      animation: wm-write 2.4s cubic-bezier(0.4, 0.05, 0.35, 1) 0.5s both;
    }

    /* the gold V breathes very gently once the name has settled (hero only) */
    :global(html.js body.is-loaded) .wordmark:not(.is-collapsed) :global(.mark-v) {
      animation: wm-breath 5s ease-in-out 3.3s infinite;
    }
  }

  /* the slanted reveal edge sweeps across, top leading bottom (the italic angle) */
  @keyframes wm-write {
    from {
      clip-path: polygon(-50% -50%, -12% -50%, -26% 150%, -50% 150%) fill-box;
    }
    to {
      clip-path: polygon(-50% -50%, 140% -50%, 126% 150%, -50% 150%) fill-box;
    }
  }

  @keyframes wm-breath {
    0%,
    100% {
      filter: drop-shadow(0 0 0 rgb(217 179 108 / 0));
    }

    50% {
      filter: drop-shadow(0 0 12px rgb(217 179 108 / 0.3));
    }
  }

  /* ---- hover: lift + V glow + a single warm sheen across the letters ----
     works on the hero lockup AND the collapsed home mark */
  .wordmark:hover {
    scale: 1.014;
  }

  .wordmark:hover :global(.mark-v) {
    animation: none;
    filter: drop-shadow(0 0 22px rgb(217 179 108 / 0.52));
  }

  .wordmark::after {
    content: '';
    position: absolute;
    inset: -8% -5%;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 44%,
      color-mix(in srgb, var(--color-accent-bright) 40%, transparent) 50%,
      transparent 56%
    );
    mix-blend-mode: screen;
    opacity: 0;
    transform: translateX(-55%);
  }

  .wordmark:hover::after {
    animation: wm-sheen 0.85s ease-out forwards;
  }

  @keyframes wm-sheen {
    0% {
      opacity: 0;
      transform: translateX(-55%);
    }

    25% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(55%);
    }
  }

  @media (max-width: 820px), (max-height: 519px), (pointer: coarse) and (max-width: 1024px), (prefers-reduced-motion: reduce) {
    .wordmark {
      /* mobile: a static lockup at the top that scrolls away with the page.
         Top and size both come from the hero stack in global.css. */
      position: absolute;
      left: 7vw;
      top: var(--hero-wm-top);
      transform: none !important;
    }

    .wordmark :global([data-wm-tail]) {
      opacity: 1 !important;
      transform: none !important;
    }

    /* landscape phone: size off the height, or the lockup fills the hero */
    @media (max-height: 519px) {
      .wordmark {
        top: 5svh;
        --wm-h: clamp(2.5rem, 15svh, 4.5rem);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .wordmark {
      opacity: 1;
      transition: none;
    }

    .wordmark :global([data-wm-tail]) {
      clip-path: none !important;
      animation: none !important;
    }

    .wordmark :global(.mark-v) {
      animation: none !important;
      filter: none !important;
    }

    .wordmark::after {
      display: none;
    }

    .wordmark:hover {
      scale: none;
    }
  }
</style>
