---
import logo from '../assets/brand/logo.svg?raw';

const links = [
  { id: 'about', label: 'About' },
  { id: 'work', label: 'Work' },
  { id: 'process', label: 'Process' },
  { id: 'contact', label: 'Contact' },
];
---

<a
  class="nav-home"
  href="/#hero"
  data-section-link="hero"
  data-nav-home
  aria-label="Valentin Lenzing — back to top"
>
  <span aria-hidden="true" set:html={logo}></span>
</a>

<nav class="navbar" aria-label="Main navigation">
  <ul class="navbar__list">
    {links.map((link) => (
      <li>
        <a class="navbar__item" href={`/#${link.id}`} data-section-link={link.id}>
          <span>{link.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<div class="progress" aria-hidden="true" data-progress>
  <span class="progress__fill" data-progress-fill></span>
</div>

<style>
  /* full-width bar with the items flushed right via flex + padding — this can
     never extend past the right edge the way a shrink-to-fit right:X element
     can if its containing block is mis-resolved */
  .navbar {
    position: fixed;
    top: calc(40px + env(safe-area-inset-top, 0px));
    left: 0;
    right: 0;
    z-index: 60;
    display: flex;
    justify-content: flex-end;
    padding-right: calc(56px + env(safe-area-inset-right, 0px));
    padding-left: 7vw;
    pointer-events: none;
  }

  /* compact VL home mark — the mobile counterpart of the desktop wordmark
     morph. Hidden on desktop (the morphing wordmark already is the home
     button); on mobile it fades in once the hero has scrolled away. */
  .nav-home {
    position: fixed;
    top: calc(14px + env(safe-area-inset-top, 0px));
    left: calc(16px + env(safe-area-inset-left, 0px));
    z-index: 62;
    display: none;
    color: var(--color-text);
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity 0.3s ease, transform 0.3s var(--ease-glide);
  }

  .nav-home :global(svg) {
    display: block;
    height: 26px;
    width: auto;
  }

  /* two-tone monogram: gold V, cream L (matches the hero wordmark) */
  .nav-home :global(.mark-v) {
    color: var(--color-accent);
  }

  .nav-home.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .navbar__list {
    display: flex;
    align-items: baseline;
    gap: 34px;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: auto;
  }

  .navbar__item {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.22s ease;
  }

  .navbar__item span {
    position: relative;
    display: inline-block;
    padding-bottom: 5px;
  }

  .navbar__item span::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--color-accent);
    transition: right 0.28s ease;
  }

  .navbar__item:hover {
    color: var(--color-text);
  }

  /* load-in: items drop in one after another once the hero has settled */
  :global(html.js) .navbar__item {
    opacity: 0;
    translate: 0 -10px;
    transition:
      color 0.22s ease,
      opacity 0.65s ease var(--nav-d, 0.85s),
      translate 0.65s var(--ease-glide) var(--nav-d, 0.85s);
  }

  :global(html.js) li:nth-child(2) .navbar__item {
    --nav-d: 0.93s;
  }

  :global(html.js) li:nth-child(3) .navbar__item {
    --nav-d: 1.01s;
  }

  :global(html.js) li:nth-child(4) .navbar__item {
    --nav-d: 1.09s;
  }

  :global(html.js body.is-loaded) .navbar__item {
    opacity: 1;
    translate: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .navbar__item {
      opacity: 1;
      translate: none;
      transition: color 0.22s ease;
    }
  }

  .navbar__item:hover span::after,
  .navbar__item.is-active span::after {
    right: 0;
  }

  .navbar__item.is-active {
    color: var(--color-accent);
  }

  /* horizontal scroll progress — appears once side-panning begins */
  .progress {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    z-index: 55;
    background: rgb(217 179 108 / 0.12);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }

  .progress__fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (max-width: 820px), (prefers-reduced-motion: reduce) {
    .navbar {
      top: calc(20px + env(safe-area-inset-top, 0px));
      padding-right: calc(18px + env(safe-area-inset-right, 0px));
      padding-left: 64px;
    }

    .navbar__list {
      gap: 16px;
    }

    .navbar__item {
      font-size: 11px;
      letter-spacing: 0.1em;
    }

    .progress {
      display: none;
    }

    /* the compact home mark is a mobile affordance */
    .nav-home {
      display: inline-flex;
    }

    /* a soft top scrim so page text fades out behind the fixed bar instead of
       colliding with it (mobile scrolls vertically under the nav) */
    .navbar::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: calc(74px + env(safe-area-inset-top, 0px));
      background: linear-gradient(180deg, var(--color-bg) 55%, rgb(26 24 22 / 0));
      pointer-events: none;
      z-index: -1;
    }
  }

  /* very narrow phones — keep all four items on one line, fully on-screen */
  @media (max-width: 430px) {
    .navbar {
      top: calc(16px + env(safe-area-inset-top, 0px));
      padding-right: calc(12px + env(safe-area-inset-right, 0px));
      padding-left: 48px;
    }

    .navbar__list {
      gap: 10px;
    }

    .navbar__item {
      font-size: 10px;
      letter-spacing: 0.04em;
    }
  }
</style>
