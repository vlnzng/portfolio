---
// The hero panel holds only the text block; the wordmark and portrait are fixed
// shell elements (Wordmark, SharedPortrait) so they can travel across panels.
---

<section class="section hero" id="hero" aria-label="Hero">
  <div class="hero-text" data-hero-text>
    <p class="hero-role">Product Designer &middot; UX/UI</p>
    <h1 class="hero-pitch">
      Building clear, trustworthy digital tools <br />from user research to implementation.
    </h1>
    {/* only rendered on mobile / reduced motion — on desktop the statement lives in ScrollCue */}
    <p class="hero-statement" aria-label="Learned the rules. Practising the exceptions.">
      <span class="hs-phrase">Learned the rules.</span>
      <span class="hs-phrase gold">Practising the exceptions.</span>
    </p>
  </div>
</section>

<style>
  .hero {
    background: var(--color-bg);
  }

  /* right below the wordmark: one column, wordmark → role → pitch */
  .hero-text {
    position: absolute;
    left: 5.5vw;
    top: 54vh;
    /* grows with --up, so the upscaled pitch keeps its two-line break */
    max-width: max(640px, calc(640 / 17 * var(--up)));
    z-index: 40;
    /* the engine's rest position, so nothing moves when its chunk arrives */
    transform: translateY(min(64px, calc(100vh * 64 / 1080)));
    will-change: transform;
  }

  .hero-role {
    margin: 0 0 24px;
    font-family: var(--font-body);
    font-weight: 600;
    /* sized up so it reads as a peer of the pitch / statement, not a caption */
    font-size: max(clamp(15px, 1.35vw, 20px), calc(20 / 17 * var(--up)));
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-pitch {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: max(clamp(22px, 2.1vw, 31px), calc(31 / 17 * var(--up)));
    line-height: 1.5;
    color: var(--color-text);
  }

  /* on the engine the statement lives in the scroll cue; shown when stacked */
  .hero-statement {
    display: none;
    gap: 2px;
    margin: 26px 0 0;
    max-width: none;
    font-family: var(--font-body);
    font-weight: 400;
    /* --up matters for reduced motion on a large desktop */
    font-size: max(16px, calc(16 / 17 * var(--up)));
    letter-spacing: 0.01em;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .hs-phrase {
    display: block;
  }

  .hero-statement .gold {
    color: var(--color-accent);
  }

  /* ---- load-in: role → pitch → statement rise on first paint ---- */
  :global(html.js) .hero-text > * {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.8s var(--ease-glide), transform 0.9s var(--ease-glide);
  }

  :global(html.js body.is-loaded) .hero-role {
    transition-delay: 0.35s;
  }

  :global(html.js body.is-loaded) .hero-pitch {
    transition-delay: 0.5s;
  }

  :global(html.js body.is-loaded) .hero-statement {
    transition-delay: 0.65s;
  }

  :global(html.js body.is-loaded) .hero-text > * {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero-text > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 820px), (max-height: 519px), (pointer: coarse) and (max-width: 1024px), (prefers-reduced-motion: reduce) {
    /* the portrait below the text is a shell sibling with no flow height, so
       the panel reserves its band */
    .hero {
      min-height: max(100svh, calc(var(--hero-portrait-top) + var(--hero-portrait-h)));
    }

    .hero-text {
      left: 7vw;
      right: 7vw;
      /* placed off the hero stack (global.css) */
      top: var(--hero-text-top);
      max-width: none;
      transform: none;
    }

    .hero-statement {
      display: grid;
    }

    /* the fixed two-line break is a desktop composition — let it reflow */
    .hero-pitch br {
      display: none;
    }

    .hero-pitch {
      text-wrap: balance;
    }

    /* landscape phone: too short to stack (~400px of the ~700 needed), so the
       figure sits beside the text and the panel is one viewport again */
    @media (max-height: 519px) and (min-width: 560px) {
      .hero {
        min-height: 100svh;
      }

      .hero-text {
        top: 30svh;
        right: 48vw;
      }

      .hero-pitch {
        text-wrap: pretty;
      }
    }
  }
</style>
