---
// The hero panel now holds only the text block. The wordmark and the portrait
// are fixed shell elements (Wordmark.astro / SharedPortrait.astro) so they can
// morph / glide across panels, driven by scroll.ts.
---

<section class="section hero" id="hero" aria-label="Hero">
  <div class="hero-text" data-hero-text>
    <p class="hero-role">Product Designer &middot; UX/UI</p>
    <h1 class="hero-pitch">
      Building clear, trustworthy digital tools <br />from user research to implementation.
    </h1>
    {/* only rendered on mobile / reduced motion — on desktop the statement lives in ScrollCue */}
    <p class="hero-statement" aria-label="Learned the rules. Practising the exceptions.">
      <span class="hs-phrase">Learned the rules.</span>
      <span class="hs-phrase gold">Practising the exceptions.</span>
    </p>
  </div>
</section>

<style>
  .hero {
    padding: 0;
    background: var(--color-bg);
  }

  /* sits right below the wordmark so the left half reads as one composed
     column (wordmark → role → pitch) instead of two stranded islands */
  .hero-text {
    position: absolute;
    left: 5.5vw;
    top: 54vh;
    /* scales with --up alongside the type inside it — held at 640px the
       upscaled pitch broke its deliberate two-line <br> into four ragged ones */
    max-width: max(640px, calc(640 / 17 * var(--up)));
    z-index: 40;
    will-change: transform;
  }

  .hero-role {
    margin: 0 0 24px;
    font-family: var(--font-body);
    font-weight: 600;
    /* sized up so it reads as a peer of the pitch / statement, not a caption */
    font-size: max(clamp(15px, 1.35vw, 20px), calc(20 / 17 * var(--up)));
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-pitch {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: max(clamp(22px, 2.1vw, 31px), calc(31 / 17 * var(--up)));
    line-height: 1.5;
    color: var(--color-text);
  }

  .hero-statement {
    display: grid;
    gap: 2px;
    margin: 26px 0 0;
    max-width: none;
    font-family: var(--font-body);
    font-weight: 400;
    /* only rendered on mobile / reduced motion — the upscale matters for the
       reduced-motion desktop case, where this replaces the scroll cue */
    font-size: max(16px, calc(16 / 17 * var(--up)));
    letter-spacing: 0.01em;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .hs-phrase {
    display: block;
  }

  .hero-statement .gold {
    color: var(--color-accent);
  }

  /* On the desktop engine the statement lives in the scroll cue instead */
  @media (min-width: 821px) and (min-height: 520px) and (prefers-reduced-motion: no-preference) {
    .hero-statement {
      display: none;
    }
  }

  /* ---- load-in: role → pitch → statement rise on first paint ---- */
  :global(html.js) .hero-text > * {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.8s var(--ease-glide), transform 0.9s var(--ease-glide);
  }

  :global(html.js body.is-loaded) .hero-role {
    transition-delay: 0.35s;
  }

  :global(html.js body.is-loaded) .hero-pitch {
    transition-delay: 0.5s;
  }

  :global(html.js body.is-loaded) .hero-statement {
    transition-delay: 0.65s;
  }

  :global(html.js body.is-loaded) .hero-text > * {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero-text > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 820px), (max-height: 519px), (prefers-reduced-motion: reduce) {
    /* mobile composition: the text block sits at the top, just under the
       wordmark; the portrait drops to the lower half (see SharedPortrait) */
    .hero-text {
      left: 7vw;
      right: 7vw;
      /* svh so the whole hero composition (text + portrait below) is measured
         against the same viewport the panel itself uses — see SharedPortrait */
      top: 25svh;
      max-width: none;
    }

    /* the fixed two-line break is a desktop composition — let it reflow */
    .hero-pitch br {
      display: none;
    }

    .hero-pitch {
      text-wrap: balance;
    }

    /* Landscape phone: wide and short. Stacking lockup → text → portrait
       needs ~700px of height and there are ~400, so the figure moves beside
       the text (the desktop composition, statically placed). */
    @media (max-height: 519px) and (min-width: 560px) {
      .hero-text {
        top: 30svh;
        right: 48vw;
      }

      .hero-pitch {
        text-wrap: pretty;
      }
    }
  }
</style>
