---
// One fixed portrait shared across panels: rests hero-right, glides to
// about-left as the pan begins. desktop-engine.ts drives left/width/transform.
import { Picture } from 'astro:assets';
import portrait from '../assets/images/portrait.png';
---

<div class="portrait" aria-hidden="true" data-portrait>
  <div class="portrait__glow"></div>
  {/* the mobile LCP element. fallbackFormat keeps the <img src> off the
      multi-MB source PNG; 768/1152 cover a 92vw phone at DPR 2 and 3. `sizes`
      lists every arm of the engine boundary, or a stacked tablet gets the
      52vw candidate */}
  <Picture
    src={portrait}
    formats={['webp']}
    fallbackFormat="webp"
    quality={80}
    alt=""
    widths={[768, 960, 1152, 1440, 1920, 2560]}
    sizes="(max-width: 820px) 92vw, (max-height: 519px) 92vw, (pointer: coarse) and (max-width: 1024px) 92vw, 52vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="portrait__fade portrait__fade--b"></div>
</div>

<style>
  .portrait {
    position: fixed;
    top: 0;
    left: 50vw;
    width: 52vw;
    height: 100vh;
    z-index: 30;
    /* the engine's rest position, so nothing moves when its chunk arrives */
    transform: translateY(15vh);
    /* transparent: the cut-out floats directly on the page, no background box */
    will-change: left, width, transform;
  }

  /* picture is the parallax layer (desktop-engine.ts); the img carries the load-in */
  .portrait picture {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    will-change: transform;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 50% 14%;
  }

  /* ---- load-in from the first paint, not gated on body.is-loaded (fonts + JS)
     like the rest of the hero: this is the mobile LCP element. It always ends at
     opacity 1, so it can't stay hidden without JS. ---- */
  @media (prefers-reduced-motion: no-preference) {
    .portrait img {
      animation: sp-settle-in 1.2s var(--ease-glide) both;
    }
  }

  @keyframes sp-settle-in {
    from {
      opacity: 0;
      transform: scale(1.05);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- idle: only the halo breathes — animating the photo itself forced
     layer re-rasterisation that read as the image "loading again" ---- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js body.is-loaded) .portrait__glow {
      animation: sp-glow-breath 9s ease-in-out 3s infinite;
    }
  }

  @keyframes sp-glow-breath {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.72;
    }
  }

  /* warm light behind the figure; it overhangs the box so the gradient has
     faded out before any edge */
  .portrait__glow {
    position: absolute;
    inset: -14%;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(52% 46% at 50% 50%, rgb(217 179 108 / 0.11), transparent 70%);
  }

  /* lower edge dissolves into the page so the torso isn't hard-cut */
  .portrait__fade--b {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 14%;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(0deg, var(--color-bg), transparent);
  }

  @media (max-width: 820px), (max-height: 519px), (pointer: coarse) and (max-width: 1024px), (prefers-reduced-motion: reduce) {
    /* stacked: below the hero text, scrolling away with the page */
    .portrait {
      position: absolute;
      left: auto;
      right: 0;
      /* starts where the text block ends (hero stack, global.css) */
      top: var(--hero-portrait-top);
      width: 92%;
      height: var(--hero-portrait-h);
      transform: none !important;
    }

    /* nothing may bleed sideways here: .section is overflow: visible when
       stacked, and mobile browsers rescale the page to fit any overflow. So
       the glow bleeds vertically only, and the picture clips the load-in scale. */
    .portrait__glow {
      inset: -14% 0;
    }

    .portrait picture {
      overflow: hidden;
    }

    .portrait__fade--b {
      height: 16%;
    }

    /* landscape phone: the figure takes the right half instead (see Hero.astro) */
    @media (max-height: 519px) and (min-width: 560px) {
      .portrait {
        top: 6svh;
        width: 46%;
        height: 94svh;
      }
    }
  }
</style>
