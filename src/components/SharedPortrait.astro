---
// One fixed portrait shared across panels: rests hero-right, glides to
// about-left as the pan begins. scroll.ts drives left/width/transform.
import { Picture } from 'astro:assets';
import portrait from '../assets/images/portrait.png';
---

<div class="portrait" aria-hidden="true" data-portrait>
  <div class="portrait__glow"></div>
  {/* This is the LCP element on mobile, so both knobs here matter.
      fallbackFormat: without it the fallback <img src> is the untouched 2.67MB
      source PNG, which is what link scrapers and "open image in new tab" get.
      widths: 768 and 1152 cover a 92vw phone at DPR 2 and 3 — without them the
      smallest candidate was 960w and a 3x phone jumped straight to 1440w. */}
  <Picture
    src={portrait}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={80}
    alt=""
    widths={[768, 960, 1152, 1440, 1920, 2560]}
    sizes="(max-width: 820px) 92vw, (max-height: 519px) 92vw, 52vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="portrait__fade portrait__fade--b"></div>
</div>

<style>
  .portrait {
    position: fixed;
    top: 0;
    left: 50vw;
    width: 52vw;
    height: 100vh;
    z-index: 30;
    /* transparent: the cut-out floats directly on the page, no background box */
    will-change: left, width, transform;
  }

  /* picture is the parallax layer (scroll.ts nudges it a few px against the
     cursor while the figure rests); the img inside carries load-in + breath */
  .portrait picture {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    will-change: transform;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 50% 14%;
  }

  /* ---- load-in: the figure settles into place (opacity and scale finish
     together — a trailing transform kept "re-animating" the photo).
     Driven by a CSS animation that starts with the first paint, NOT by the
     `body.is-loaded` flag the rest of the hero waits on: that flag waits for
     document.fonts.ready (the wordmark needs it so its write-in never paints
     in a fallback face — a photo does not) plus the module bundle, which held
     the largest element on the page at opacity 0 for ~2.3s and made it the
     mobile LCP bottleneck. No JS gate needed either — the animation always
     runs to opacity 1, so the figure is never stuck hidden. ---- */
  @media (prefers-reduced-motion: no-preference) {
    .portrait img {
      animation: sp-settle-in 1.2s var(--ease-glide) both;
    }
  }

  @keyframes sp-settle-in {
    from {
      opacity: 0;
      transform: scale(1.05);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- idle: only the halo breathes — animating the photo itself forced
     layer re-rasterisation that read as the image "loading again" ---- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js body.is-loaded) .portrait__glow {
      animation: sp-glow-breath 9s ease-in-out 3s infinite;
    }
  }

  @keyframes sp-glow-breath {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.72;
    }
  }

  /* soft warm light behind the whole figure (not a halo around the head).
     The layer extends past the container so the gradient has fully faded
     before any edge — no hard cut towards the navbar. */
  .portrait__glow {
    position: absolute;
    inset: -14%;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(52% 46% at 50% 50%, rgb(217 179 108 / 0.11), transparent 70%);
  }

  /* lower edge dissolves into the page so the torso isn't hard-cut */
  .portrait__fade--b {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 14%;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(0deg, var(--color-bg), transparent);
  }

  @media (max-width: 820px), (max-height: 519px), (prefers-reduced-motion: reduce) {
    /* mobile: the cut-out sits in the LOWER half of the hero, below the text
       block (wordmark + role + pitch + statement live above it). Scrolls away
       with the page. */
    .portrait {
      position: absolute;
      left: auto;
      right: 0;
      /* starts where the text block ends (hero stack, global.css) instead of at
         a viewport fraction — at 54svh it slid up over the statement on short
         phones. It may now run past the fold; that is the point, more of the
         figure comes in as you scroll. */
      top: var(--hero-portrait-top);
      width: 92%;
      height: var(--hero-portrait-h);
      transform: none !important;
    }

    /* Nothing in the hero may stick out sideways here: the panel is exactly
       as wide as the screen and `.section` is `overflow: visible` on mobile,
       so any bleed becomes real document overflow — and a mobile browser
       answers that by rescaling the whole page, which is why the site used to
       *start* looking zoomed and then settle.
       1) the glow bled 14% (~51px) past the right edge — bleed vertically
          only; the gradient is fully transparent well before the side edges
       2) the load-in scale(1.05) spilled ~9px each side for its first 1.2s —
          clip it to the frame it is settling into */
    .portrait__glow {
      inset: -14% 0;
    }

    .portrait picture {
      overflow: hidden;
    }

    .portrait__fade--b {
      height: 16%;
    }

    /* Landscape phone: no room for a figure *below* the text — it takes the
       right half of the hero instead (see Hero.astro). */
    @media (max-height: 519px) and (min-width: 560px) {
      .portrait {
        top: 6svh;
        width: 46%;
        height: 94svh;
      }
    }
  }
</style>
