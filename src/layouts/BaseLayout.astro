---
import '@fontsource-variable/lora/index.css';
import '@fontsource-variable/inter/index.css';
// Lora's real italic instead of a synthesised oblique; it only downloads where
// italic text renders.
import '@fontsource-variable/lora/wght-italic.css';
// Preloaded below, or they're found a round trip late and the hero type swaps in
// visibly. Imported as URLs so the hash matches the build.
import loraLatin from '@fontsource-variable/lora/files/lora-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  initialModalSlug?: string;
  // the 404 page answers for every unknown URL, so it has no address to name
  notFound?: boolean;
}

const {
  title = SITE.title,
  description = 'Portfolio of Valentin Lenzing, Product Designer · UX/UI, working across research, interaction design, and front-end implementation.',
  ogImage = '/og-image.jpg',
  initialModalSlug,
  notFound = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
// The /work/<slug> deep links serve the homepage HTML (the modal opens via JS),
// so they're duplicate content — point their canonical at the homepage.
const canonicalURL = new URL(initialModalSlug ? '/' : Astro.url.pathname, site);
// og:url keeps the real address: Facebook and LinkedIn resolve shares through it
// and would show a case link with the homepage preview. Canonical does the SEO.
const ogURL = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1A1816" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {!notFound && <link rel="canonical" href={canonicalURL} />}

    <link rel="preload" as="font" type="font/woff2" href={loraLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Valentin Lenzing" />
    {!notFound && <meta property="og:url" content={ogURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Valentin Lenzing — Product Designer · UX/UI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, site)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Valentin Lenzing',
        jobTitle: 'Product Designer (UX/UI)',
        url: site.href,
        sameAs: [SITE.social.linkedin, SITE.social.github],
      })}
    />

    {/* entrance choreography is gated behind html.js, so nothing hides without JS */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    {/* site chrome (the home shell, the legal / 404 headers) sits outside <main>,
        so the skip link really skips it */}
    <slot name="furniture" />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    {initialModalSlug && (
      <script is:inline define:vars={{ initialModalSlug }}>
        window.__initialModalSlug = initialModalSlug;
      </script>
    )}

    <SpeedInsights />
    <Analytics />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
